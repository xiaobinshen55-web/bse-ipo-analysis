    "AVERAGE_PRICE": { "excel": "均价(元)", "json": "avg_price", "convert": null },
    "EXPECT_ISSUE_NUM": { "excel": "发行总数(万股)", "json": null, "convert": "div10000" },
    "ONLINE_ISSUE_NUM": { "excel": "网上发行数量(万股)", "json": null, "convert": "div10000" },
    "APPLY_NUM_UPPER": { "excel": "申购上限(万股)", "json": null, "convert": "div10000" },
    "APPLY_AMT_UPPER": { "excel": "顶格所需资金(万元)", "json": null, "convert": "div10000" },
